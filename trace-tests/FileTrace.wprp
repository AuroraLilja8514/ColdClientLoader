<?xml version="1.0" encoding="utf-8"?>
<WindowsPerformanceRecorder Version="1.0" Author="ColdClientManager trace test">
  <Profiles>
    <SystemCollector Id="FileCollector" Name="CCM file operations">
      <BufferSize Value="1024" />
      <Buffers Value="128" />
    </SystemCollector>
    <SystemProvider Id="FileProvider">
      <Keywords>
        <Keyword Value="ProcessThread" />
        <Keyword Value="Loader" />
        <Keyword Value="FileIO" />
        <Keyword Value="FileIOInit" />
      </Keywords>
    </SystemProvider>
    <Profile Id="CCMFileTrace.Verbose.File" Name="CCMFileTrace" Description="Process tree and file operation test" LoggingMode="File" DetailLevel="Verbose">
      <Collectors>
        <SystemCollectorId Value="FileCollector">
          <SystemProviderId Value="FileProvider" />
        </SystemCollectorId>
      </Collectors>
    </Profile>
  </Profiles>
</WindowsPerformanceRecorder>
